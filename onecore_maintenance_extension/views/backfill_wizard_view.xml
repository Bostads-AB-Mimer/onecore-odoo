<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="maintenance_backfill_wizard_form" model="ir.ui.view">
            <field name="name">maintenance.backfill.wizard.form</field>
            <field name="model">maintenance.backfill.wizard</field>
            <field name="arch" type="xml">
                <form string="Lägg till">
                    <sheet>
                        <field name="maintenance_request_id" invisible="1" />
                        <field name="lookup_kind" invisible="1" />
                        <field name="state" invisible="1" />
                        <field name="object_option_ref" invisible="1" />
                        <field name="is_vacant" invisible="1" />

                        <div class="alert alert-warning" role="alert"
                            invisible="state != 'preview' or not is_vacant">
                            <i class="fa fa-exclamation-triangle me-2" />
                            Hyresobjektet saknar aktivt kontrakt. Det kopplas till
                            ärendet utan hyresgäst (tomställt).
                        </div>

                        <group invisible="state != 'input'">
                            <field name="lookup_value"
                                string="Objektnummer"
                                invisible="lookup_kind != 'rental_object'"
                                placeholder="Klistra in objektnummer" />
                            <field name="lookup_value"
                                string="Kundnummer"
                                invisible="lookup_kind != 'tenant'"
                                placeholder="Klistra in kundnummer" />
                        </group>

                        <group invisible="state != 'preview' or not lease_option_id">
                            <field name="lease_option_id" string="Kontrakt"
                                domain="[('user_id', '=', uid)]"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                help="Välj vilket kontrakt som ska kopplas till ärendet (hyresobjekt och hyresgäst följer med)." />
                        </group>
                        <group string="Hyresobjekt"
                            invisible="state != 'preview' or not prev_object_id">
                            <field name="prev_object_id" />
                            <field name="prev_object_address"
                                invisible="not prev_object_address" />
                            <field name="prev_object_property"
                                invisible="not prev_object_property" />
                        </group>
                        <group string="Hyresgäst"
                            invisible="state != 'preview' or not prev_tenant_name">
                            <field name="prev_tenant_name" />
                            <field name="prev_tenant_contact"
                                invisible="not prev_tenant_contact" />
                        </group>
                    </sheet>
                    <footer>
                        <button string="Sök" name="action_search" type="object"
                            class="btn-primary" invisible="state != 'input'" />
                        <button string="Lägg till" name="action_confirm" type="object"
                            class="btn-primary" invisible="state != 'preview'" />
                        <button string="Avbryt" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

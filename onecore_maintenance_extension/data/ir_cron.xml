<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
        Two jobs on purpose: they have completely different tempos.

        noupdate="1" so ops can retune the intervals without an upgrade
        overwriting them.
        -->

        <!--
        Kvartersvärdsområden (33 rows) with responsible + distriktschef.
        One GET /kvv-areas per run. Stewards change a few times a month, so
        nightly is plenty - run it manually after reassigning someone in
        Förvaltningsområden if you don't want to wait.
        -->
        <record id="ir_cron_sync_kvv_areas" model="ir.cron">
            <field name="name">Ärenden: synka kvartersvärdsområden från OneCore</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_kvv_areas()</field>
            <!-- Pinned, like Odoo's own crons: user_id otherwise defaults to
                 whoever ran the upgrade, and noupdate="1" freezes that. -->
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0, second=0) + timedelta(days=1))"/>
            <field name="active" eval="True"/>
        </record>

        <!--
        Backfill of distrikt/kvartersvärdsområde on requests that lack it:
        everything created before this feature, plus anything created while
        OneCore was down. Writes ONLY the management-area fields - never
        Resursgrupp/Resurs. Cost per run is the cost-center trees (a handful
        of calls) regardless of batch size, so the batch is large and the
        interval long. Once the backlog is done this is one query that
        returns nothing.
        -->
        <record id="ir_cron_backfill_management_area" model="ir.cron">
            <field name="name">Ärenden: hämta distrikt/kvartersvärdsområde från OneCore</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_backfill_management_area()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!--
        MIM-1970: backfill of "Beställande resursgrupp" on requests created
        before the field existed. The orderer is guessed from who created the
        request and which team they belong to today - ordering_backfilled_at
        marks every guessed row so it stays distinguishable from the ones
        stamped at create. Pure DB work, no HTTP, so the batch is large.
        Self-consuming: once the backlog is stamped this is one query that
        returns nothing. Writes ONLY the ordering_* fields - never
        Resursgrupp/Resurs/Steg.

        SHIPPED INACTIVE ON PURPOSE. The five district teams (Vast, Ost, Norr,
        Mitt, Studentteam) are archived in production until the kvartersvardar
        start working in Odoo, and Odoo's search() excludes archived records -
        so the derivation cannot see them. Their 50 members would be stamped
        with their functional group (Fastighetsservice, Driftenheten, ...)
        instead of their district, permanently: the domain is self-consuming,
        so the cron never revisits a stamped request. MIM-1975/1976 would then
        be built on top of an empty answer.

        Turn it on in Installningar -> Teknisk -> Schemalagda atgarder AFTER
        the district teams are unarchived. Until then the field is still set
        correctly on every newly created request - only the backfill waits.
        -->
        <record id="ir_cron_backfill_ordering_team" model="ir.cron">
            <field name="name">Ärenden: härled beställande resursgrupp</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_backfill_ordering_team()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>

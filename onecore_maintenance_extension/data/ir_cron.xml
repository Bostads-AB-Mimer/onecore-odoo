<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
        Two jobs on purpose: they have completely different tempos.

        noupdate="1" so ops can retune the intervals without an upgrade
        overwriting them.
        -->

        <!--
        Kvartersvärdsområden (33 rows) with responsible + distriktschef.
        One GET /kvv-areas per run. Stewards change a few times a month, so
        nightly is plenty - run it manually after reassigning someone in
        Förvaltningsområden if you don't want to wait.
        -->
        <record id="ir_cron_sync_kvv_areas" model="ir.cron">
            <field name="name">Ärenden: synka kvartersvärdsområden från OneCore</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_kvv_areas()</field>
            <!-- Pinned, like Odoo's own crons: user_id otherwise defaults to
                 whoever ran the upgrade, and noupdate="1" freezes that. -->
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0, second=0) + timedelta(days=1))"/>
            <field name="active" eval="True"/>
        </record>

        <!--
        Backfill of distrikt/kvartersvärdsområde on requests that lack it:
        everything created before this feature, plus anything created while
        OneCore was down. Writes ONLY the management-area fields - never
        Resursgrupp/Resurs. Cost per run is the cost-center trees (a handful
        of calls) regardless of batch size, so the batch is large and the
        interval long. Once the backlog is done this is one query that
        returns nothing.
        -->
        <record id="ir_cron_backfill_management_area" model="ir.cron">
            <field name="name">Ärenden: hämta distrikt/kvartersvärdsområde från OneCore</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_backfill_management_area()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!--
        Spärr skadedjur on open requests. Cost per run is two fixed OneCore
        calls (block-reason captions, then rental-ids) regardless of how many
        cases are open - flat API cost, though the run is still one wide
        SELECT over all open requests, and only requests whose value actually
        changed are written, so a quiet run issues no UPDATE at all. Short
        interval because the badge is a safety warning for whoever is sent to
        the address.
        -->
        <record id="ir_cron_sync_pest_control" model="ir.cron">
            <field name="name">Ärenden: synka spärr skadedjur från OneCore</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_pest_control()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!--
        Viktig kundinfo on the tenants of open requests. specialAttention is
        snapshotted when the case is created and would otherwise never pick up
        a change made in Xpand afterwards. Hourly: the flag is set by hand and
        changes very rarely, and a run costs one call per 200 contact codes.
        -->
        <record id="ir_cron_sync_special_attention" model="ir.cron">
            <field name="name">Ärenden: synka viktig kundinfo från OneCore</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_special_attention()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!--
        Kontraktsstatus + sista debiteringsdatum on the lease of every open
        request. A contract snapshotted at case creation can change status
        afterwards (MIM-1954); the run costs one call per 500 distinct lease
        ids (POST /leases/batch), not one per open request. Hourly, like
        viktig kundinfo: a contract's status changes about as often as that
        flag does.
        -->
        <record id="ir_cron_sync_lease_status" model="ir.cron">
            <field name="name">Ärenden: synka kontraktsstatus från OneCore</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_lease_status()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!--
        MIM-1970/2011: backfill of "Beställande avdelning" on requests that
        have none - created before the field existed, or by someone whose AD
        department had not yet reached Odoo. The orderer's department is
        read as it is today; ordering_backfilled_at marks every guessed row
        so it stays distinguishable from the ones stamped at create. Pure DB
        work, no HTTP, so the batch is large. Self-consuming: once the
        backlog is stamped this is one query that returns nothing. Writes
        ONLY the ordering_* fields - never Resursgrupp/Resurs/Steg.

        SHIPPED INACTIVE ON PURPOSE, like every other backfill here. The
        department reaches res.users through the Keycloak login hook, at each
        person's next SSO login after the protocol mapper went live. The
        backfill leaves a request alone while its orderer is an active SSO
        user who has not logged in yet, and gives up (stamps "looked, could
        not tell") only for archived or never-linked users - so it converges
        on its own and can be switched on as soon as the mapper is live.

        Turn it on in Installningar -> Teknisk -> Schemalagda atgarder once
        the mapper exists in prod-Keycloak. Until then the field is still set
        correctly on every newly created request whose orderer has a value.
        -->
        <record id="ir_cron_backfill_ordering_department" model="ir.cron">
            <field name="name">Ärenden: härled beställande avdelning</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_backfill_ordering_department()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
    </data>

    <!--
    Outside the noupdate block on purpose. The first version of MIM-1970
    shipped a cron "Ärenden: härled beställande resursgrupp" that called
    _cron_backfill_ordering_team(), a method that no longer exists. It never
    reached prod, but the epic/dev databases have it, and noupdate="1" means
    an upgrade would otherwise leave it behind - inactive, right next to its
    replacement, waiting for somebody to switch on the wrong one.

    By search, not by id: the id form logs a warning with a traceback on every
    upgrade where the record is missing, which is every upgrade in prod. The
    explicit active leaf is what makes the search see an inactive cron.
    -->
    <data>
        <delete model="ir.cron"
            search="[('code', '=', 'model._cron_backfill_ordering_team()'), ('active', 'in', [True, False])]"/>
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="onecore_mail_extension.TenantChatter" t-inherit="mail.Chatter" t-inherit-mode="extension">
        <!-- Hides the Send to and recipients list in the chatter/composer -->
    <xpath expr="//RecipientsInput/.." position="replace">
        <div class="mb-4" />
    </xpath>

        <!-- Disable the "Send message" button if the record is restricted for external contractors -->
    <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="attributes">
        <attribute name="t-att-disabled">props.record.data.restricted_external or (!state.thread.hasWriteAccess and !(state.thread.hasReadAccess and state.thread.canPostOnReadonly) and props.threadId)</attribute>
    </xpath>

        <!-- Disable the "Activities" button if the record is restricted for external contractors -->
    <xpath expr="//button[hasclass('o-mail-Chatter-activity')]" position="attributes">
        <attribute name="t-att-disabled">props.record.data.restricted_external</attribute>
    </xpath>

    <!-- Acknowledge dialog button — only on maintenance.request when there's an unread log-note dialog -->
    <xpath expr="//button[hasclass('o-mail-Chatter-activity')]" position="after">
        <button class="btn btn-warning ms-1 align-self-center text-nowrap"
                t-if="props.record?.resModel === 'maintenance.request' and (props.record.data.has_unread_supplier_dialog or props.record.data.has_unread_internal_dialog or props.record.data.has_unread_master_key_change)"
                t-on-click="onClickAcknowledgeDialog">
            Markera som läst
        </button>
    </xpath>

    <!-- Pinned messages section ("Fästa") at the top of the chatter content -->
    <xpath expr="//div[hasclass('o-mail-Chatter-content')]/t[1]" position="before">
        <div class="o-mimer-PinnedMessages" t-if="pinnedMessages.length">
            <div class="o-mimer-PinnedMessages-header">
                <i class="fa fa-thumb-tack me-1"/>Fästa noteringar
            </div>
            <t t-foreach="pinnedMessages" t-as="msg" t-key="msg.id">
                <Message message="msg" thread="state.thread"/>
                <div t-if="msg.pinned_by_name" class="o-mimer-PinnedBy text-muted small">
                    Fäst av <t t-esc="msg.pinned_by_name"/>
                </div>
            </t>
        </div>
    </xpath>
</t>

<t t-name="onecore_mail_extension.TenantMessageNotification" t-inherit="mail.Message.notification" t-inherit-mode="extension">
        <!-- Hides the Envelope-icon by each message -->
    <xpath expr="//span[hasclass('o-mail-Message-notification')]" position="replace" />
</t>

</templates>

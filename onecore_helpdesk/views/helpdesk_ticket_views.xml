<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.onecore_helpdesk.forms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <!-- Every ticket made in Odoo needs a category, and a form when
                 the category has any (email tickets get the team's default
                 category). The same rule is enforced server side. -->
            <field name="category_id" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="category_id" position="after">
                <field name="category_form_count" invisible="1"/>
                <field name="addon_form_id" invisible="1"/>
                <!-- Stays visible on a ticket whose only form was archived,
                     so the agent can see which questions it answered. -->
                <field
                    name="form_id"
                    invisible="not category_form_count and not form_id"
                    required="category_form_count > 0"
                    options="{'no_create': True, 'no_open': True}"
                />
            </field>
            <!-- OCA hides the properties until a team is set; the questions
                 now come from the form instead -->
            <field name="properties" position="attributes">
                <attribute name="invisible">not form_id</attribute>
            </field>
            <!-- Two question blocks, each under a rule with a title and an
                 intro: the form's questions, then the category's add-on form
                 (title and intro from the respective form record). -->
            <xpath expr="//field[@name='properties']/.." position="before">
                <div class="mt-4 pt-3 border-top" invisible="not form_id">
                    <field
                        name="form_question_title"
                        readonly="1"
                        nolabel="1"
                        class="h5 d-block mb-1"
                    />
                    <field
                        name="form_question_intro"
                        readonly="1"
                        nolabel="1"
                        class="text-muted small mb-3"
                        invisible="not form_question_intro"
                    />
                </div>
            </xpath>
            <xpath expr="//field[@name='properties']/.." position="after">
                <div class="mt-4 pt-3 border-top" invisible="not addon_form_id">
                    <field
                        name="addon_question_title"
                        readonly="1"
                        nolabel="1"
                        class="h5 d-block mb-1"
                    />
                    <field
                        name="addon_question_intro"
                        readonly="1"
                        nolabel="1"
                        class="text-muted small mb-3"
                        invisible="not addon_question_intro"
                    />
                    <div class="d-flex mb-3">
                        <field
                            name="addon_properties"
                            nolabel="1"
                            columns="2"
                            hideKanbanOption="1"
                        />
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_ticket_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.onecore_helpdesk.forms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_search"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="form_id"/>
            </field>
            <filter name="group_category" position="after">
                <filter
                    string="Formulär"
                    name="group_form"
                    domain="[]"
                    context="{'group_by': 'form_id'}"
                />
            </filter>
        </field>
    </record>

    <record id="ticket_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list.onecore_helpdesk.forms</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_tree"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="form_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Stages -->
        <record id="stage_new" model="helpdesk.ticket.stage">
            <field name="sequence">1</field>
            <field name="name">Ny</field>
            <field name="unattended" eval="True"/>
            <field name="closed" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="stage_in_progress" model="helpdesk.ticket.stage">
            <field name="sequence">2</field>
            <field name="name">Pågår</field>
            <field name="closed" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="stage_awaiting_user" model="helpdesk.ticket.stage">
            <field name="sequence">3</field>
            <field name="name">Väntar på användare</field>
            <field name="closed" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="stage_user_replied" model="helpdesk.ticket.stage">
            <field name="sequence">4</field>
            <field name="name">Återkopplad</field>
            <field name="closed" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="stage_ordered" model="helpdesk.ticket.stage">
            <field name="sequence">5</field>
            <field name="name">Beställd</field>
            <field name="closed" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="stage_solved" model="helpdesk.ticket.stage">
            <field name="sequence">6</field>
            <field name="name">Löst</field>
            <field name="closed" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="stage_closed" model="helpdesk.ticket.stage">
            <field name="sequence">7</field>
            <field name="name">Stängt</field>
            <field name="closed" eval="True"/>
            <field name="fold" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Categories -->
        <record id="category_it_fault" model="helpdesk.ticket.category">
            <field name="sequence">1</field>
            <field name="name">Felanmälan IT</field>
            <!-- its add-on form (Påverkan) is set in helpdesk_it_form_data.xml -->
        </record>
        <record id="category_equipment_order" model="helpdesk.ticket.category">
            <field name="sequence">2</field>
            <field name="name">Beställning av utrustning</field>
        </record>
        <record id="category_teams_order" model="helpdesk.ticket.category">
            <field name="sequence">3</field>
            <field name="name">Beställning av Teams</field>
        </record>
        <record id="category_it_other" model="helpdesk.ticket.category">
            <field name="sequence">4</field>
            <field name="name">Övriga IT-frågor</field>
        </record>
        <record id="category_tenant_fault" model="helpdesk.ticket.category">
            <field name="sequence">5</field>
            <field name="name">Felanmälan hyresgäster och sökande</field>
        </record>
        <record id="category_property_it_order" model="helpdesk.ticket.category">
            <field name="sequence">6</field>
            <field name="name">Beställning IT i fastigheter</field>
        </record>

        <!-- Team: a reply on Väntar på användare or Löst moves the ticket to
             Återkopplad, and Löst closes silently after 2 inactive days -->
        <record id="team_it" model="helpdesk.ticket.team">
            <field name="name">IT</field>
            <field name="category_ids" eval="[(6, 0, [
                ref('category_it_fault'),
                ref('category_equipment_order'),
                ref('category_teams_order'),
                ref('category_it_other'),
                ref('category_tenant_fault'),
                ref('category_property_it_order'),
            ])]"/>
            <!-- email tickets are free text and land here -->
            <field name="default_category_id" ref="category_it_other"/>
            <field name="autoupdate_ticket_stage" eval="True"/>
            <field name="autopupdate_src_stage_ids" eval="[(6, 0, [ref('stage_awaiting_user'), ref('stage_solved')])]"/>
            <field name="autopupdate_dest_stage_id" ref="stage_user_replied"/>
            <field name="close_inactive_tickets" eval="True"/>
            <field name="ticket_stage_ids" eval="[(6, 0, [ref('stage_solved')])]"/>
            <field name="inactive_tickets_day_limit_warning">0</field>
            <field name="inactive_tickets_day_limit_closing">2</field>
            <field name="close_inactive_mail_template_id" eval="False"/>
            <field name="closing_ticket_stage" ref="stage_closed"/>
        </record>
    </data>

    <!-- Archive the generic OCA stages so only the stages above are offered -->
    <data>
        <function model="helpdesk.ticket.stage" name="write">
            <value eval="[
                ref('helpdesk_mgmt.helpdesk_ticket_stage_new'),
                ref('helpdesk_mgmt.helpdesk_ticket_stage_in_progress'),
                ref('helpdesk_mgmt.helpdesk_ticket_stage_awaiting'),
                ref('helpdesk_mgmt.helpdesk_ticket_stage_done'),
                ref('helpdesk_mgmt.helpdesk_ticket_stage_cancelled'),
                ref('helpdesk_mgmt.helpdesk_ticket_stage_rejected'),
            ]"/>
            <value eval="{'active': False}"/>
        </function>
    </data>
</odoo>

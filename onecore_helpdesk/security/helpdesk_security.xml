<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="helpdesk_ticket_form_comp_rule" model="ir.rule">
            <field name="name">Helpdesk Form Company Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket_form"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <!-- same pattern as helpdesk_mgmt.helpdesk_ticket_team_portal_rule -->
        <record id="helpdesk_ticket_form_portal_rule" model="ir.rule">
            <field name="name">Helpdesk Form Portal Rule</field>
            <field name="model_id" ref="model_helpdesk_ticket_form"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('show_in_portal', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
